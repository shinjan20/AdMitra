import React, { useEffect, useRef, useState } from 'react';
import {
  ArrowLeft,
  ArrowRight,
  Camera,
  Compass,
  MapPin,
  MessageCircle,
  Mic,
  Pencil,
  Play,
  Send,
} from 'lucide-react';
import { useApp } from '../../context/AppContext';
import { APP_LANGUAGES, BUSINESS_CATEGORIES, UiKey } from '../../services/language';
import { DEMO_SCENARIOS } from '../../utils/demoData';

interface LandingPageProps {
  onSignIn: () => void;
  onCreateCampaign: () => void;
}

type DemoScenarioId = keyof typeof DEMO_SCENARIOS;

const demoScenarioLookup: Record<DemoScenarioId, {
  category: UiKey;

  businessName: string;
  city: string;
  area: string;
  offer: string;
  objective: string;
  headline: string;
  description: string;
  cta: string;
  audience: string;
  budget: number;
  duration: number;
  radiusKm: number;
  image: string;
}> = {
  salon: {
    category: 'categoryBeauty',
    businessName: 'Aura Bridal Studio',
    city: 'Lucknow',
    area: 'Gomti Nagar',
    offer: 'Bridal makeup packages from ₹4,999. Ask about available dates.',
    objective: 'messages',
    headline: 'Your bridal look, your way',
    description: 'Thoughtful bridal makeup for your special day. Ask us about services and appointments.',
    cta: 'Send WhatsApp Message',
    audience: 'People interested in bridal services near your business',
    budget: 5000,
    duration: 10,
    radiusKm: 5,
    image: 'https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=900&auto=format&fit=crop&q=80',
  },
  restaurant: {
    category: 'categoryRestaurant',
    businessName: 'Nukkad Kitchen',
    city: 'Mumbai',
    area: 'Bandra West',
    offer: 'Family meal combo for four from ₹799. Dine-in and takeaway.',
    objective: 'messages',
    headline: 'Good food, close to home',
    description: 'Bring everyone together over a comforting meal. Ask about today’s family combo.',
    cta: 'Send WhatsApp Message',
    audience: 'Nearby residents looking for local dining options',
    budget: 3500,
    duration: 7,
    radiusKm: 3,
    image: 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=900&auto=format&fit=crop&q=80',
  },
  coaching: {
    category: 'categoryEducation',
    businessName: 'BrightPath Coaching',
    city: 'Chennai',
    area: 'Adyar',
    offer: 'New maths and science batches starting this month. Enquire for timings.',
    objective: 'leads',
    headline: 'A stronger start in maths and science',
    description: 'Small-group coaching with room to ask questions. Enquire about the next batch.',
    cta: 'Book Now',
    audience: 'Students and families near your coaching centre',
    budget: 4000,
    duration: 10,
    radiusKm: 5,
    image: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=900&auto=format&fit=crop&q=80',
  },
};

export const LandingPage: React.FC<LandingPageProps> = ({ onSignIn, onCreateCampaign }) => {
  const { language, setLanguage, t, tr, logFunnel } = useApp();
  const [demoOpen, setDemoOpen] = useState(false);
  const [demoStep, setDemoStep] = useState(0);
  const [scenarioId, setScenarioId] = useState<DemoScenarioId>('beauty_salon');
  const demoRef = useRef<HTMLElement>(null);
  const demoSteps: { title: UiKey; description: UiKey; icon: typeof Mic }[] = [
    { title: 'shopSetup', description: 'shopIntro', icon: Compass },
    { title: 'offerQuestion', description: 'offerHint', icon: Mic },
    { title: 'nearbyArea', description: 'sampleOnly', icon: MapPin },
    { title: 'preview', description: 'sampleOnly', icon: Camera },
  ];

  useEffect(() => {
    if (demoOpen) demoRef.current?.scrollIntoView({ block: 'start' });
  }, [demoOpen]);

  const showDemo = () => {
    setDemoStep(0);
    setDemoOpen(true);
    logFunnel('demo_started');
  };

  const selectDemoStep = (step: number) => {
    if (step === demoSteps.length - 1 && demoStep !== step) {
      logFunnel('demo_completed', undefined, { scenario: scenarioId });
    }
    setDemoStep(step);
  };

  const handleMakeAdWithSample = () => {
    const scenario = DEMO_SCENARIOS[scenarioId];
    if (!scenario) {
      console.error(`Demo scenario not found: ${scenarioId}`);
      return;
    }

    // Store the complete scenario data to localStorage for wizard initialization
    localStorage.setItem('admitra:demo-scenario', JSON.stringify(scenario));
    logFunnel('campaign_conversion_clicked', undefined, { scenario: scenarioId });
    onCreateCampaign();
  };

  const activeScenario = DEMO_SCENARIOS[scenarioId] && demoScenarioLookup[scenarioId]
    ? { ...DEMO_SCENARIOS[scenarioId], ...demoScenarioLookup[scenarioId] }
    : null;
  const activeDemo = demoSteps[demoStep];
  const DemoIcon = activeDemo.icon;

  return (
    <div className="landing-background min-h-screen text-[color:var(--ink)]">
      <header className="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:h-20 sm:px-6">
        <div className="inline-flex items-center gap-2.5">
          <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[color:var(--ink)] text-[color:var(--marigold)]">
            <Compass className="h-5 w-5" aria-hidden="true" />
          </span>
          <span className="text-xl font-bold tracking-tight">
            Ad<span className="brand-accent">Mitra</span>
          </span>
        </div>
        <div className="flex items-center gap-1.5 sm:gap-3">
          <label className="sr-only" htmlFor="landing-language">{t('chooseLanguage')}</label>
          <select
            id="landing-language"
            value={language}
            onChange={(event) => setLanguage(event.target.value as typeof language)}
            className="min-h-11 max-w-[7.5rem] rounded-xl border border-[color:var(--line-strong)] bg-white px-2.5 text-sm font-medium text-[color:var(--ink)] focus:outline-none focus:ring-2 focus:ring-[color:var(--brand)] sm:max-w-none sm:px-3"
          >
            {APP_LANGUAGES.map((option) => (
              <option key={option.code} value={option.code}>{option.name}</option>
            ))}
          </select>
          <button
            type="button"
            onClick={onSignIn}
            className="inline-flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-[color:var(--ink)] underline decoration-[color:var(--line-strong)] decoration-2 underline-offset-4 hover:decoration-[color:var(--brand)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--brand)] sm:px-4"
          >
            {t('signIn')}
          </button>
        </div>
      </header>

      <main>
        <section className="mx-auto grid max-w-6xl items-center gap-12 px-4 pb-14 pt-6 sm:px-6 sm:pb-20 sm:pt-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] lg:gap-16">
          <div className="max-w-xl">
            <span className="chip">
              <span className="h-1.5 w-1.5 rounded-full bg-[color:var(--brand)]" aria-hidden="true" />
              {t('landingEyebrow')}
            </span>
            <h1 className="display mt-5 text-[2.5rem] font-bold sm:text-[3.25rem] lg:text-[3.75rem]">
              {t('campaignPlanHeadline')}
            </h1>
            <p className="mt-5 max-w-lg text-[1.0625rem] leading-relaxed text-[color:var(--ink-soft)]">
              {t('campaignPlanBody')}
            </p>
            <div className="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
              <button type="button" onClick={onCreateCampaign} className="btn-accent sm:w-auto">
                {t('makeAd')}
                <ArrowRight className="h-5 w-5" aria-hidden="true" />
              </button>
              <button type="button" onClick={showDemo} className="btn-secondary">
                <Play className="h-4 w-4 fill-current" aria-hidden="true" />
                {t('demoButton')}
              </button>
            </div>
            <p className="mt-5 flex max-w-md items-start gap-2 text-sm leading-relaxed text-[color:var(--ink-soft)]">
              <span className="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--leaf)]" aria-hidden="true" />
              {t('sampleOnly')}
            </p>
          </div>

          <div className="relative mx-auto w-full max-w-[22rem] sm:max-w-[24rem]">
            <div
              aria-hidden="true"
              className="absolute inset-x-5 -top-3 h-[94%] rotate-[3deg] rounded-[1.6rem] border border-[color:var(--line)] bg-[color:var(--paper-deep)]"
            />
            <figure className="relative -rotate-[1.5deg] rounded-[1.6rem] border border-[color:var(--line)] bg-white p-2.5 shadow-[0_32px_60px_-34px_rgba(26,24,21,0.55)]">
              <div className="relative overflow-hidden rounded-[1.15rem]">
                <img
                  src={activeScenario.image}
                  alt={t('preview')}
                  className="aspect-[4/5] w-full object-cover"
                  loading="lazy"
                />
                <span className="absolute left-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[0.6875rem] font-bold text-[color:var(--marigold-ink)]">
                  {t('preview')}
                </span>
                <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/55 to-transparent px-4 pb-4 pt-14 text-white">
                  <p className="text-xs font-semibold text-white/80">{activeScenario.businessName}</p>
                  <p className="display mt-1 text-[1.6rem] font-bold leading-[1.1]">
                    {activeScenario.headline}
                  </p>
                  <p className="mt-1.5 text-[0.8125rem] leading-snug text-white/90">
                    {activeScenario.offer}
                  </p>
                  <span className="mt-3 inline-flex items-center gap-1.5 rounded-lg bg-[#25d366] px-3 py-2 text-xs font-bold text-[#0b3d2c]">
                    <MessageCircle className="h-3.5 w-3.5" aria-hidden="true" />
                    {activeScenario.cta}
                  </span>
                </div>
              </div>
            </figure>
            <figcaption className="mt-4 flex items-center justify-center gap-2 text-center text-xs text-[color:var(--ink-soft)]">
              <Pencil className="h-3.5 w-3.5 text-[color:var(--brand)]" aria-hidden="true" />
              {t('editBeforeShare')}
            </figcaption>
          </div>
        </section>

        <section aria-label={t('demoTitle')} className="mx-auto max-w-6xl px-4 pb-16 sm:px-6">
          <ul className="grid gap-3 border-t border-[color:var(--line)] pt-6 sm:grid-cols-3">
            <li className="flex items-start gap-2.5 text-sm text-[color:var(--ink-soft)]">
              <Send className="mt-0.5 h-4 w-4 shrink-0 text-[color:var(--brand)]" aria-hidden="true" />
              <span>{t('offerQuestion')}</span>
            </li>
            <li className="flex items-start gap-2.5 text-sm text-[color:var(--ink-soft)]">
              <Pencil className="mt-0.5 h-4 w-4 shrink-0 text-[color:var(--brand)]" aria-hidden="true" />
              <span>{t('editBeforeShare')}</span>
            </li>
            <li className="flex items-start gap-2.5 text-sm text-[color:var(--ink-soft)]">
              <MessageCircle className="mt-0.5 h-4 w-4 shrink-0 text-[color:var(--brand)]" aria-hidden="true" />
              <span>{t('copyAd')}</span>
            </li>
          </ul>
        </section>

        {demoOpen && (
          <section
            id="product-demo"
            ref={demoRef}
            aria-labelledby="product-demo-title"
            className="mx-auto max-w-6xl scroll-mt-4 px-4 pb-20 sm:px-6"
          >
            <div className="surface-raised overflow-hidden">
              <div className="flex flex-wrap items-start justify-between gap-4 border-b border-[color:var(--line)] bg-[color:var(--paper)]/60 p-5 sm:p-7">
                <div>
                  <span className="chip">{t('demoButton')}</span>
                  <h2 id="product-demo-title" className="display mt-2 text-2xl font-bold sm:text-3xl">
                    {t('demoTitle')}
                  </h2>
                  <p className="mt-2 text-sm text-[color:var(--ink-soft)]">{t('sampleOnly')}</p>
                </div>
                <button
                  type="button"
                  onClick={() => setDemoOpen(false)}
                  className="btn-secondary min-h-11 px-3 text-sm"
                >
                  <ArrowLeft className="h-4 w-4" aria-hidden="true" />
                  {t('back')}
                </button>
              </div>

              <div className="grid gap-6 p-5 sm:p-7 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
                <div>
                  <ol className="space-y-2" aria-label={t('demoTitle')}>
                    {demoSteps.map((step, index) => {
                      const StepIcon = step.icon;
                      return (
                        <li key={step.title}>
                          <button
                            type="button"
                            onClick={() => selectDemoStep(index)}
                            aria-pressed={demoStep === index}
                            className={`flex min-h-12 w-full items-center gap-3 rounded-xl border px-3 text-left text-sm font-semibold transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--brand)] ${
                              demoStep === index
                                ? 'border-[color:var(--marigold)] bg-[color:var(--marigold-soft)] text-[color:var(--marigold-ink)]'
                                : 'border-transparent text-[color:var(--ink-soft)] hover:bg-white'
                            }`}
                          >
                            <span className={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full ${
                              demoStep === index
                                ? 'bg-[color:var(--marigold)] text-[color:var(--ink)]'
                                : 'bg-white text-[color:var(--ink-soft)] ring-1 ring-[color:var(--line)]'
                            }`}>
                              <StepIcon className="h-4 w-4" aria-hidden="true" />
                            </span>
                            <span className="min-w-0 flex-1">{t(step.title)}</span>
                            <span className="text-xs font-medium opacity-70">{index + 1}/{demoSteps.length}</span>
                          </button>
                        </li>
                      );
                    })}
                  </ol>
                  <div className="mt-5 flex gap-2">
                    <button
                      type="button"
                      onClick={() => selectDemoStep(Math.max(0, demoStep - 1))}
                      disabled={demoStep === 0}
                      className="btn-secondary min-h-11 px-3 text-sm disabled:cursor-not-allowed disabled:opacity-50"
                    >
                      <ArrowLeft className="h-4 w-4" aria-hidden="true" />
                      {t('back')}
                    </button>
                    {demoStep < demoSteps.length - 1 && (
                      <button
                        type="button"
                        onClick={() => selectDemoStep(Math.min(demoSteps.length - 1, demoStep + 1))}
                        className="btn-primary min-h-11 text-sm"
                      >
                        {t('continue')}
                        <ArrowRight className="h-4 w-4" aria-hidden="true" />
                      </button>
                    )}
                  </div>
                </div>

                <div className="rounded-2xl border border-[color:var(--line)] bg-[color:var(--paper)]/70 p-4 sm:p-6" aria-live="polite">
                  <div className="flex items-start gap-3">
                    <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-[color:var(--brand)] ring-1 ring-[color:var(--line)]">
                      <DemoIcon className="h-5 w-5" aria-hidden="true" />
                    </span>
                    <div>
                      <h3 className="text-lg font-bold">{activeDemo.title}</h3>
                      <p className="mt-1 text-sm leading-relaxed text-[color:var(--ink-soft)]">{activeDemo.description}</p>
                    </div>
                  </div>

                  <div className="mt-5 overflow-hidden rounded-xl border border-[color:var(--line)] bg-white">
                    {demoStep === 3 && (
                      <img
                        src={activeScenario.image}
                        alt={t('preview')}
                        className="aspect-[16/8] w-full object-cover"
                      />
                    )}
                    {demoStep === 0 && (
                      <div className="space-y-4 p-5">
                        <fieldset>
                          <legend className="mb-2 text-sm font-semibold">{t('businessType')}</legend>
                          <div className="grid gap-2 sm:grid-cols-3">
                            {(Object.keys(demoScenarios) as DemoScenarioId[]).map((id) => (
                              <button
                                key={id}
                                type="button"
                                aria-pressed={scenarioId === id}
                                onClick={() => setScenarioId(id)}
                                className={`min-h-11 rounded-lg border px-3 text-left text-sm font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[color:var(--brand)] ${
                                  scenarioId === id
                                    ? 'border-[color:var(--marigold)] bg-[color:var(--marigold-soft)] text-[color:var(--marigold-ink)]'
                                    : 'border-[color:var(--line)] bg-white text-[color:var(--ink-soft)] hover:bg-[color:var(--paper)]'
                                }`}
                              >
                                {t(demoScenarios[id].category)}
                              </button>
                            ))}
                          </div>
                        </fieldset>
                        <p className="text-xs font-semibold text-[color:var(--ink-soft)]">{t('yourBusiness')}</p>
                        <p className="font-bold">{activeScenario.businessName}</p>
                        <div className="grid gap-3 sm:grid-cols-2">
                          <div className="rounded-lg border border-[color:var(--line)] bg-[color:var(--paper)]/60 p-3">
                            <p className="text-xs text-[color:var(--ink-soft)]">{t('businessType')}</p>
                            <p className="mt-1 text-sm font-semibold">{BUSINESS_CATEGORIES.find((cat) => cat.key === activeScenario.category)?.value || activeScenario.category}</p>
                          </div>
                          <div className="rounded-lg border border-[color:var(--line)] bg-[color:var(--paper)]/60 p-3">
                            <p className="text-xs text-[color:var(--ink-soft)]">{t('city')}</p>
                            <p className="mt-1 text-sm font-semibold">{activeScenario.city}</p>
                          </div>
                          <div className="rounded-lg border border-[color:var(--line)] bg-[color:var(--paper)]/60 p-3">
                            <p className="text-xs text-[color:var(--ink-soft)]">{t('area')}</p>
                            <p className="mt-1 text-sm font-semibold">{activeScenario.area}</p>
                          </div>
                          <div className="rounded-lg border border-[color:var(--line)] bg-[color:var(--paper)]/60 p-3 sm:col-span-2">
                            <p className="text-xs text-[color:var(--ink-soft)]">{t('chooseLanguage')}</p>
                            <p className="mt-1 text-sm font-semibold">
                              {APP_LANGUAGES.find((item) => item.code === language)?.name}
                            </p>
                          </div>
                        </div>
                      </div>
                    )}
                    {demoStep === 1 && (
                      <div className="space-y-4 p-4">
                        <div className="rounded-xl rounded-tl-sm bg-[color:var(--marigold-soft)] p-4 text-sm leading-relaxed text-[color:var(--ink)]">
                          {activeScenario.offer}
                        </div>
                        <div className="rounded-lg border border-[color:var(--line)] bg-white p-4">
                          <p className="text-xs font-medium text-[color:var(--ink-soft)]">Campaign goal</p>
                          <p className="mt-1 text-sm font-bold">
                            {activeScenario.objective === 'messages' ? t('messageEnquiries') : activeScenario.objective === 'leads' ? t('bookingEnquiries') : t('awareness')}
                          </p>
                        </div>
                      </div>
                    )}
                    {demoStep === 2 && (
                      <div className="grid gap-3 p-4 sm:grid-cols-2">
                        <div className="rounded-lg border border-[color:var(--line)] bg-white p-4">
                          <p className="text-xs font-medium text-[color:var(--ink-soft)]">{tr('Suggested audience')}</p>
                          <p className="mt-1 text-sm font-bold">{activeScenario.audience}</p>
                          <p className="mt-2 text-xs text-[color:var(--ink-soft)]">{tr('You can edit the location and reach.')}</p>
                        </div>
                        <div className="rounded-lg border border-[color:var(--line)] bg-white p-4">
                          <p className="text-xs font-medium text-[color:var(--ink-soft)]">{tr('Example budget and duration')}</p>
                          <p className="mt-1 text-sm font-bold">₹{activeScenario.budget.toLocaleString('en-IN')}</p>
                          <p className="mt-1 text-sm text-[color:var(--ink-soft)]">{activeScenario.duration} days</p>
                          <p className="mt-2 text-xs text-[color:var(--ink-soft)]">{tr('This amount is not charged.')}</p>
                        </div>
                      </div>
                    )}
                    {demoStep === 3 && (
                      <div className="space-y-3 p-4">
                        <div className="flex flex-wrap items-center justify-between gap-2">
                          <p className="text-xs font-semibold text-[color:var(--ink-soft)]">{tr('Sample ad preview')}</p>
                          <span className="chip">{tr('Not published')}</span>
                        </div>
                        <p className="text-lg font-bold">{activeScenario.headline}</p>
                        <p className="text-sm leading-relaxed text-[color:var(--ink-soft)]">{activeScenario.description}</p>
                        <div className="flex flex-wrap gap-2 text-xs text-[color:var(--ink-soft)]">
                          <span className="rounded-md bg-[color:var(--paper-deep)] px-2.5 py-1.5">
                            {activeScenario.objective === 'messages' ? t('messageEnquiries') : activeScenario.objective === 'leads' ? t('bookingEnquiries') : t('awareness')}
                          </span>
                          <span className="rounded-md bg-[color:var(--paper-deep)] px-2.5 py-1.5">₹{activeScenario.budget.toLocaleString('en-IN')}</span>
                          <span className="rounded-md bg-[color:var(--paper-deep)] px-2.5 py-1.5">{activeScenario.duration} days</span>
                          <span className="rounded-md bg-[color:var(--paper-deep)] px-2.5 py-1.5">{activeScenario.radiusKm} km</span>
                        </div>
                        <p className="text-xs leading-relaxed text-[color:var(--ink-soft)]">{t('sampleOnly')}</p>
                        <button
                          type="button"
                          onClick={handleMakeAdWithSample}
                          className="btn-primary mt-1 text-sm"
                        >
                          {tr('Make my ad with this sample')}
                          <ArrowRight className="h-4 w-4" aria-hidden="true" />
                        </button>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </section>
        )}
      </main>
    </div>
  );
};
